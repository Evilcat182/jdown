# Copy to .env and fill in:  cp .env.example .env
# See README.md for a description of every variable.

# ── VPN (required) ───────────────────────────────────────────────────────────
OPENVPN_USER=
OPENVPN_PASSWORD=

# ── gluetun control server API key (required) ───────────────────────────────
# Shared secret between gluetun and jbot, any value you like.
# Use letters and digits only (no " \ or $), e.g. the output of:  openssl rand -hex 16
GLUETUN_API_KEY=

# ── Host paths (required) ────────────────────────────────────────────────────
DOWNLOADS_PATH=
MOVIE_DESTINATION=
SERIES_DESTINATION=

# ── Premium download account (optional) ─────────────────────────────────────
PREMIUM_ACCOUNT_HOSTER=
PREMIUM_ACCOUNT_USERNAME=
PREMIUM_ACCOUNT_PASSWORD=

# ── Archive extraction passwords, comma-separated (optional) ────────────────
EXTRACTION_PASSWORDS=

# ── Plex integration (optional) ─────────────────────────────────────────────
PLEX_API_ROOT=
PLEX_TOKEN=
PLEX_MOVIE_LIB_NAME=
PLEX_SHOW_LIB_NAME=

# ── Firefox startup URL(s), separated by | (optional) ───────────────────────
FF_OPEN_URL=

# ── Verbose debug logging, 1 to enable (optional) ───────────────────────────
DEBUG=0
